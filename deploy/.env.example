POSTGRES_DB=bidcopilot
POSTGRES_USER=bidcopilot
POSTGRES_PASSWORD=replace-me
JWT_SECRET_KEY=
# 留空时容器首启生成随机密钥并持久化到 /data/jwt.key；显式填写必须是随机值，
# 占位符/低熵值会被应用拒绝启动。
# 加密主密钥（模型 Key / Webhook secret 等 AES-GCM 信封加密）：base64 编码的 32 字节。
# 单容器缺省会随机生成并持久化到 /data/model-master.key；显式提供时轮换会使存量密文无法解密。
MODEL_SECRET_MASTER_KEY=
KEEPRISK_API_BASE_URL=https://api.keeprisk.com:9080/api/data
# 商机数据网关 AppCode——联系开通：https://github.com/xrzlizheng（README「标讯数据网关」一节）。
# 未配置时仅商机发现不可用，解析/生成/合规/合同审查不受影响。
KEEPRISK_APP_CODE=replace-with-keeprisk-app-code
# KeepRisk 企业数据 MCP（股权/工商/尽调）：token 只放环境变量或密钥管理，禁止入库
KEEPRISK_MCP_ENABLED=false
KEEPRISK_MCP_URL=https://mcp.keeprisk.com/mcp
KEEPRISK_MCP_TOKEN=
KEEPRISK_MCP_TIMEOUT_SECONDS=30
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_TIMEOUT_SECONDS=60
MINIMAX_API_KEY=
MINIMAX_API_HOST=https://api.minimaxi.com
MINIMAX_OCR_MAX_PAGES=10
# OCR 供应商：auto=MiniMax 优先、缺省回落本地 MinerU；显式 minimax/mineru/none 覆盖。
# 本地 MinerU 已预装进镜像并 bake basic 档模型（ONNX 小模型，纯 CPU）。
# MINERU_TIER：auto=按显存自适应（CUDA 可用且 ≥ MINERU_GPU_MIN_VRAM_GB 时选
# standard/VLM 档，否则 basic）；显式 flash/basic/standard/advanced 指定档位。
# 本镜像默认 CPU 构建，auto 恒收敛 basic；standard 档需 CUDA 构建变体并 bake
# 对应模型，或放开 MINERU_MODEL_SOURCE 联网下载。
# MINIMAX_OCR_MAX_PAGES 同时是 MinerU 的 PDF 解析页数预算。
OCR_PROVIDER=auto
OCR_TIMEOUT_SECONDS=120
MINERU_TIER=auto
MINERU_GPU_MIN_VRAM_GB=8.0
MINERU_TIMEOUT_SECONDS=300
WEB_SEARCH_PROVIDER=deepseek
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_MAX_RESULTS=10
DEEPSEEK_SEARCH_API_KEY=
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com
MINIMAX_SEARCH_API_KEY=
MINIMAX_SEARCH_BASE_URL=https://api.minimax.cn/anthropic
MINIMAX_SEARCH_MODEL=MiniMax-M3
MINIO_ROOT_USER=bidcopilot
MINIO_ROOT_PASSWORD=replace-me
MINIO_ACCESS_KEY=bidcopilot
MINIO_SECRET_KEY=replace-me

# 商机订阅定时同步（单容器镜像默认开启）
SCHEDULER_ENABLED=true
OPPORTUNITY_MAX_SUBSCRIPTIONS_PER_TENANT=10
SYNC_MIN_INTERVAL_MINUTES=30
PARSE_JOB_STALE_MINUTES=15
PARSE_JOB_RECOVERY_BATCH=5

# 演示种子数据：默认关闭。显式 BIDCOPILOT_SEED_DEMO=1 时必须提供
# BIDCOPILOT_DEMO_PASSWORD，否则容器拒绝启动（不再内置默认演示口令）。
BIDCOPILOT_SEED_DEMO=0
BIDCOPILOT_DEMO_PASSWORD=

# 登录失败限流（Redis）；Redis 不可用时回落到进程内计数（不放行）
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_WINDOW_SECONDS=300

# 模型网关地址策略：默认拒绝私网/环回/链路本地；自建 LLM 用 allowlist 精确放行
MODEL_ALLOW_PRIVATE_BASE_URL=false
MODEL_ALLOWED_HOSTS=

# 按次计费接口租户配额（0=关闭）
PAID_CALL_DAILY_LIMIT=1000
PAID_CALL_MONTHLY_LIMIT=20000

# 通知渠道：SMTP 邮件推送（企业微信 Webhook 由页面配置，无需服务端密钥）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# 开放 API Webhook 出站（API 令牌在「账号设置 → 开放 API」页签发，无需服务端配置）
WEBHOOK_DELIVERY_ENABLED=true
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_SECONDS=0.5
# 默认拒绝私网/环回/链路本地；自建接收端用 allowlist 精确放行（逗号分隔）
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_ALLOW_PRIVATE_URL=false
